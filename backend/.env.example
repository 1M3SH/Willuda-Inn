# =========================================================
# WILLUDA INN BACKEND - ENVIRONMENT VARIABLES
# =========================================================

# Server Port (Auto-assigned by Railway in production)
PORT=5000

# Database Client
DB_CLIENT=postgres

# Supabase PostgreSQL Connection String (Recommended for Railway)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Pooled or Direct)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Alternative Separate Supabase Parameters (if not using DATABASE_URL)
PG_HOST=db.[YOUR-PROJECT-REF].supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=[YOUR-PASSWORD]
PG_SSL=true

# Security
JWT_SECRET=willuda_inn_secure_jwt_secret_key_prod_2026

# Allowed Frontend Origins (Optional, defaults to reflecting request origin)
# CORS_ORIGIN=https://willuda-inn-user.vercel.app,https://willuda-inn-admin.vercel.app
